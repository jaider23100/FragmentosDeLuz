left to right direction
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #F4F1E8
  BorderColor #4A3B2C
}
component "nivel_bosque.tscn" as N
component "menu_principal.tscn" as M
component "menu_pausa.tscn" as P
component "opciones.tscn" as O
component "caballero.tscn" as C
component "slime.tscn" as S
component "murcielago.tscn" as B
component "fragmento.tscn" as F
component "moneda.tscn" as MO
component "checkpoint.tscn" as CP
component "cartel.tscn" as CA
component "roca.tscn" as R
component "viento.tscn" as V
component "puas.tscn" as PU
component "santuario.tscn" as SA
component "hud.tscn" as H
component "intro.tscn" as I
