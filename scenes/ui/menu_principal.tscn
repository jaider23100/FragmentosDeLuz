[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/menu_principal.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/opciones.tscn" id="2_opciones"]

[node name="MenuPrincipal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.18, 0.231, 0.196, 1)

[node name="Contenedor" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -60.0
offset_top = -60.0
offset_right = 60.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Titulo" type="Label" parent="Contenedor"]
layout_mode = 2
theme_override_colors/font_color = Color(0.373, 0.953, 1, 1)
theme_override_font_sizes/font_size = 16
text = "Fragmentos de Luz"
horizontal_alignment = 1

[node name="BotonJugar" type="Button" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Jugar"

[node name="BotonOpciones" type="Button" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Opciones"

[node name="BotonCreditos" type="Button" parent="Contenedor"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
disabled = true
text = "Créditos"

[node name="BotonSalir" type="Button" parent="Contenedor"]
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Salir"

[node name="Opciones" parent="." instance=ExtResource("2_opciones")]
unique_name_in_owner = true

[connection signal="pressed" from="Contenedor/BotonJugar" to="." method="_on_boton_jugar_pressed"]
[connection signal="pressed" from="Contenedor/BotonSalir" to="." method="_on_boton_salir_pressed"]
[connection signal="pressed" from="Contenedor/BotonOpciones" to="." method="_on_boton_opciones_pressed"]
[connection signal="cerrado" from="Opciones" to="." method="_on_opciones_cerrado"]
