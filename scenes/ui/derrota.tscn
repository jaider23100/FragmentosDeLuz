[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/derrota.gd" id="1_derrota"]

[node name="Derrota" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_derrota")

[node name="Fondo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.102, 0.102, 0.141, 1)

[node name="Contenedor" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -90.0
offset_top = -60.0
offset_right = 90.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Titulo" type="Label" parent="Contenedor"]
layout_mode = 2
theme_override_colors/font_color = Color(0.851, 0.263, 0.231, 1)
theme_override_font_sizes/font_size = 16
text = "La sombra te venció"
horizontal_alignment = 1

[node name="EtiquetaFragmentos" type="Label" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="EtiquetaPuntos" type="Label" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="BotonReintentar" type="Button" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
text = "Reintentar"

[node name="BotonMenu" type="Button" parent="Contenedor"]
layout_mode = 2
text = "Menú principal"

[connection signal="pressed" from="Contenedor/BotonReintentar" to="." method="_on_boton_reintentar_pressed"]
[connection signal="pressed" from="Contenedor/BotonMenu" to="." method="_on_boton_menu_pressed"]
