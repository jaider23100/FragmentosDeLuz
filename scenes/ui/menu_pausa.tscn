[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/menu_pausa.gd" id="1_pausa"]
[ext_resource type="PackedScene" path="res://scenes/ui/opciones.tscn" id="2_opciones"]

[node name="MenuPausa" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pausa")

[node name="Oscurecer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.102, 0.102, 0.141, 0.7)

[node name="Contenedor" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -50.0
offset_top = -46.0
offset_right = 50.0
offset_bottom = 46.0
theme_override_constants/separation = 4
alignment = 1

[node name="Titulo" type="Label" parent="Contenedor"]
layout_mode = 2
theme_override_colors/font_color = Color(0.373, 0.953, 1, 1)
theme_override_font_sizes/font_size = 16
text = "Pausa"
horizontal_alignment = 1

[node name="BotonContinuar" type="Button" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
text = "Continuar"

[node name="BotonReiniciar" type="Button" parent="Contenedor"]
layout_mode = 2
text = "Reiniciar nivel"

[node name="BotonOpciones" type="Button" parent="Contenedor"]
unique_name_in_owner = true
layout_mode = 2
text = "Opciones"

[node name="BotonSalir" type="Button" parent="Contenedor"]
layout_mode = 2
text = "Salir al menú"

[node name="Opciones" parent="." instance=ExtResource("2_opciones")]
unique_name_in_owner = true

[connection signal="pressed" from="Contenedor/BotonContinuar" to="." method="_on_boton_continuar_pressed"]
[connection signal="pressed" from="Contenedor/BotonReiniciar" to="." method="_on_boton_reiniciar_pressed"]
[connection signal="pressed" from="Contenedor/BotonSalir" to="." method="_on_boton_salir_pressed"]
[connection signal="pressed" from="Contenedor/BotonOpciones" to="." method="_on_boton_opciones_pressed"]
[connection signal="cerrado" from="Opciones" to="." method="_on_opciones_cerrado"]
