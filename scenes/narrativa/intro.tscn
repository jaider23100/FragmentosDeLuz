script = ExtResource("1_narrativa")
textos = Array[String](["Durante siglos, el Cristal de Luz protegió el reino de Valdoria desde el santuario del bosque.", "Una noche, Morvak, el Hechicero de Sombra, robó el Cristal y lo rompió en cinco fragmentos.", "Los esparció por el bosque. Sin su luz, los árboles se marchitaron y las criaturas se volvieron sombra.", "Sir Aldric, el último guardián del santuario, juró recuperar los cinco fragmentos. Su viaje empieza ahora."])
escena_siguiente = "res://scenes/niveles/nivel_bosque.tscn"

